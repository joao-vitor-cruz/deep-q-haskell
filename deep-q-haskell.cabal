cabal-version:      3.0
name:               deep-q-haskell
version:            0.1.0.0
synopsis:           Deep Q-Learning do zero em Haskell (CartPole)
description:        Trabalho em grupo: implementação de um agente DQN em Haskell puro.
                    Veja o README.md e o AGENTS.md.
license:            MIT
build-type:         Simple
extra-doc-files:    README.md

common shared
  default-language: Haskell2010
  ghc-options:      -Wall -O2

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    DQN.Types
    DQN.Linalg
    DQN.Env
    DQN.Network
    DQN.Backprop
    DQN.Optimizer
    DQN.Replay
    DQN.Policy
    DQN.Agent
    DQN.Experiment
  build-depends:
    , base        >=4.16 && <5
    , containers  >=0.6  && <0.8
    , deepseq     >=1.4  && <1.6
    , random      >=1.2  && <1.3

executable dqn
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  ghc-options:      -rtsopts
  build-depends:
    , base
    , containers
    , deepseq
    , directory   >=1.3 && <1.4
    , random
    , deep-q-haskell

test-suite spec
  import:             shared
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Spec.hs
  other-modules:
    DQN.TypesSpec
    DQN.LinalgSpec
    DQN.EnvSpec
    DQN.NetworkSpec
    DQN.BackpropSpec
    DQN.OptimizerSpec
    DQN.ReplaySpec
    DQN.PolicySpec
    DQN.AgentSpec
    DQN.ExperimentSpec
  build-tool-depends: hspec-discover:hspec-discover >=2.10 && <3
  build-depends:
    , base
    , containers
    , deepseq
    , hspec       >=2.10 && <3
    , QuickCheck  >=2.14 && <3
    , random
    , deep-q-haskell
